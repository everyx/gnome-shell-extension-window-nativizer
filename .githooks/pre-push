#!/bin/sh
#
# The check that belongs to what leaves the machine: test:e2e. It guards what a
# commit can break - a lifecycle, a resize band - but it drives a whole nested
# session, and a commit hook slow enough to be bypassed is worth less than a push
# hook nobody minds. Measured on this machine: about two minutes. Pushes are rare;
# commits are not.
#
# ego-lint, pack (build) and shexli (lint:zip) used to run here too, but CI runs exactly the
# same three jobs (ego-lint, pack) on every push/PR - running them locally as well taxed every
# push twice for the same verdict. They were removed from this hook; CI is their guard now.
#
# check:perf does NOT run here anymore, gated or otherwise. Its swing across sessions
# (0.70-0.90 measured on one commit against a 0.85 budget) is wider than its guard
# band, so as a per-push gate it flips coins; and at ~100s a leg it is exactly the
# bloat this hook is being slimmed of. Run it by hand after pushes that touch the
# frame paths (effects, lib reconcile, platform, extension wiring):
# `pnpm run check:perf`. A lone stress miss inside the known swing exits 2, which
# is the tool telling you a single re-run is worth it.
#
# A commit made with --no-verify therefore reaches CI with its style and behaviour unchecked; CI is
# the backstop for that, which is cheaper than running the commit checks twice on every push.
#
# What the push carries decides what runs: git hands this hook one line per ref, and when every path
# in that range is documentation or assets, none of these checks can see it - a README push paid
# four minutes for nothing before this. A new branch, a range git will not resolve, or any path the
# inert list does not recognise runs the checks as before.
#
# Bypass with `git push --no-verify` when that is what you mean. Expected cost: ~2min
# (e2e); a slow leg names itself via per-leg timestamps.

set -e

. "$(dirname "$0")/run-checks"

inert=1
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$remote_ref" ] || continue
    case "$local_sha" in 0000000*) continue ;; esac          # deleting a ref: nothing to check
    case "$remote_sha" in
        0000000*) inert=0 ;;                                 # a new branch: no range to reason about
        *)
            if changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null) &&
               printf '%s\n' "$changed" | inert_paths_only; then
                :
            else
                inert=0
            fi ;;
    esac
done

if [ "$inert" = 1 ]; then
    echo "pre-push: documentation and assets only, nothing to check"
    exit 0
fi

run_checks pre-push test:e2e