#!/bin/sh
#
# Shared by both hooks: run the named checks, one line each, and on failure print the output of the
# one that failed. Sourced rather than executed, so each hook keeps its own preconditions.

# A check may declare a precondition, so that a machine which cannot run it at all skips it loudly
# instead of blocking every commit and push there. What they need is something to run in: a GNOME
# session, to render the decoration and to drive a window through a lifecycle. On a machine that has
# one they run, and they fail on a wrong decoration or a wrong behaviour like any other check - the
# precondition is about the machine, not about the change.
# A path no check here can be affected by: documentation and assets. Reads paths on stdin and
# succeeds only when there is at least one and every one is one of those - an unknown path, or an
# empty list, means the checks run as before. Failing open is the point: a gate that guesses wrong
# is a gate that skips work silently.
inert_paths_only() {
    seen=0
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        seen=1
        case "$path" in
            *.md|docs/*|assets/*|LICENSE*) ;;
            *) return 1 ;;
        esac
    done
    [ "$seen" = 1 ]
}

check_precondition() {
    case "$1" in
        check:bench|test:e2e|check:perf|test:perf) command -v gnome-shell >/dev/null 2>&1 ;;
        *) return 0 ;;
    esac
}

run_checks() {
    hook=$1
    shift
    log=$(mktemp)
    # Original stderr: when TERM lands mid-leg the foreground command is
    # `pnpm ... >"$log" 2>&1`, so a plain >&2 inside the trap would write into
    # $log (then deleted). Fd 3 keeps the pusher-facing stderr.
    exec 3>&2
    current_check=""
    check_start=0
    check_child=""
    on_term() {
        # Kill the leg so a pusher timeout does not leave it (and its nested
        # session) running behind the hook; its own EXIT trap still reaps state.
        if [ -n "$check_child" ]; then
            kill "$check_child" 2>/dev/null
        fi
        if [ -n "$current_check" ]; then
            now=$(date +%s)
            elapsed=$((now - check_start))
            printf '\n%s: interrupted during %s after %ss (pusher timeout or Ctrl-C). The %s did NOT land; retrying is safe.\n' \
                "$hook" "$current_check" "$elapsed" "${hook#pre-}" >&3
        else
            printf '\n%s: interrupted before any check finished. The %s did NOT land; retrying is safe.\n' "$hook" "${hook#pre-}" >&3
        fi
        rm -f "$log"
        exit 130
    }
    trap on_term INT TERM
    trap 'rm -f "$log"' EXIT
    for check in "$@"; do
        if ! check_precondition "$check"; then
            printf '[%s] %-12s skipped (this machine cannot run it)\n' "$(date +%H:%M:%S)" "$check"
            continue
        fi
        current_check="$check"
        check_start=$(date +%s)
        printf '[%s] %-12s started ...\n' "$(date +%H:%M:%S)" "$check"
        pnpm run --silent "$check" >"$log" 2>&1 &
        check_child=$!
        if wait "$check_child"; then
            check_child=""
            now=$(date +%s)
            printf '[%s] %-12s ok (%ss)\n' "$(date +%H:%M:%S)" "$check" "$((now - check_start))"
        else
            status=$?
            check_child=""
            now=$(date +%s)
            printf '[%s] %-12s FAILED after %ss\n\n' "$(date +%H:%M:%S)" "$check" "$((now - check_start))"
            cat "$log"
            printf '\n%s: %s failed. Fix it, or %s with --no-verify.\n' \
                "$hook" "$check" "${hook#pre-}"
            exit "$status"
        fi
        current_check=""
    done
    exec 3>&-
}
