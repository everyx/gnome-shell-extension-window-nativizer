#!/bin/sh
#
# The checks that belong to a commit: the code lints, the generated files and catalogues match
# their sources, the unit tests pass, and the decoration still renders the way libadwaita renders one.
# Each guards something the commit itself can break, so catching it here is what keeps the commit that
# broke it the commit that fixes it - and the rendering is one of those: a shadow or a clip change that
# misses libadwaita by a level is exactly the kind of thing the unit tests cannot see.
#
# The whole-tree checks - ego-lint, and packing the extension the way a user receives it - belong to
# the push instead: see pre-push. Each check has one hook, and this one does not repeat that one's.
#
# A commit that only writes documentation or assets cannot break any of them, so it runs none: on
# this repo the chain is 34s, and paying that every time a comment or the README moves is how a hook
# earns `--no-verify`. The list of paths that counts as inert lives in run-checks, and anything it
# does not recognise runs as before - including a commit that deletes source files.
#
# Bypass with `git commit --no-verify` when that is what you mean.

set -e

. "$(dirname "$0")/run-checks"

if git diff --cached --name-only | inert_paths_only; then
    echo "pre-commit: documentation and assets only, nothing to check"
    exit 0
fi

run_checks pre-commit lint check:style lint:ego test check:decoration
