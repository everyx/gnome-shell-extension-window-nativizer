#: src/prefs.js:26
msgid "Decorate"
msgstr "加裝飾"

#: src/prefs.js:27
msgid "Leave alone"
msgstr "不加（保持原樣）"

#: src/prefs.js:28
msgid "Corners only"
msgstr "只要我們的圓角"

#: src/prefs.js:29
msgid "Shadow only"
msgstr "只要我們的陰影"

#: src/prefs.js:38
msgid "dialog"
msgstr "對話框"

#: src/prefs.js:39
msgid "modal dialog"
msgstr "模態對話框"

#: src/prefs.js:40
msgid "utility window"
msgstr "工具視窗"

#: src/prefs.js:44
msgid "window"
msgstr "視窗"

#: src/prefs.js:55
msgid "Fixed-size"
msgstr "固定尺寸"

#: src/prefs.js:55
msgid "Resizable"
msgstr "可縮放"

#: src/prefs.js:56
msgid "X11"
msgstr "X11"

#: src/prefs.js:56
msgid "Wayland"
msgstr "Wayland"

#: src/prefs.js:60
msgid "with no parent"
msgstr "無父視窗"

#: src/prefs.js:62
msgid "attached to its parent"
msgstr "附加到父視窗"

#: src/prefs.js:64
msgid "with a parent"
msgstr "有父視窗"

#. The template is the translatable unit, so a language can reorder the
#. sentence; each fragment above is translated on its own.
#: src/prefs.js:68
msgid "{size} {server} {type}, {parent}"
msgstr "{size}的 {server} {type}，{parent}"

#: src/prefs.js:163 src/prefs.js:171
msgid "OK"
msgstr "確定"

#: src/prefs.js:189
msgid "General"
msgstr "一般"

#: src/prefs.js:195
msgid "Display & Rendering"
msgstr "顯示與渲染"

#: src/prefs.js:196
msgid "Control window decoration behavior across screen scales"
msgstr "控制視窗裝飾在不同螢幕縮放下的渲染行為"

#: src/prefs.js:201
msgid "Prioritize Crisp Text"
msgstr "優先保證文字清晰"

#: src/prefs.js:202
msgid ""
"Skip rounded corners on fractional scale monitors (retaining shadow) to "
"avoid text blur and resampling overhead"
msgstr ""
"在分數縮放螢幕上免除圓角（保留陰影），消除重新取樣帶來的字體模糊與效能損耗"

#: src/prefs.js:210
msgid "Pick a window that looks wrong; the rule will be set the other way"
msgstr "選取一個顯示不正常的視窗，規則會自動設成相反的狀態"

#: src/prefs.js:216 src/prefs.js:234 src/prefs.js:235
msgid "Window Rules"
msgstr "視窗規則"

#: src/prefs.js:217
msgid "Each rule names which decorations are ours for one window kind."
msgstr "每條規則寫明某個視窗種類裡哪些裝飾由我們繪製。"

#: src/prefs.js:239
msgid "Use the button above to pick a window that looks wrong."
msgstr "用上面的按鈕選取一個顯示不正常的視窗。"

#: src/prefs.js:302
msgid "Remove Rule"
msgstr "刪除規則"

#: src/prefs.js:326
msgid "Window Inspection Failed"
msgstr "視窗選取失敗"

#: src/prefs.js:327
msgid ""
"Could not connect to Window Nativizer extension. Please ensure the extension "
"is enabled."
msgstr ""
"無法連線至 Window Nativizer 擴充套件，請確認該擴充套件已在 GNOME 擴充套件中啟"
"用。"

#: src/prefs.js:339
msgid "No rule added: this window could not be identified."
msgstr "未新增規則：無法識別這個視窗。"

#: src/prefs.js:350
msgid "No rule added: it would have no effect on a window of this kind."
msgstr "未新增規則：這條規則對此類視窗不會有任何效果。"

#: src/prefs.js:359
msgid "No rule added: the rule could not be saved."
msgstr "未新增規則：規則未能儲存。"

#: src/prefs.js:367
#, javascript-format
msgid "Rule set to: %s"
msgstr "規則已設為：%s"
