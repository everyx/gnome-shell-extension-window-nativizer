#. Translators: One of the three rule axes: rounded window corners.
#: src/lib/rulePresenter.js:42
msgid "Corners"
msgstr "圓角"

#. Translators: One of the three rule axes: the window shadow.
#: src/lib/rulePresenter.js:44
msgid "Shadow"
msgstr "陰影"

#. Translators: One of the three rule axes: the resize band around the window.
#: src/lib/rulePresenter.js:46
msgid "Resize"
msgstr "縮放"

#: src/lib/rulePresenter.js:72
msgid "Automatic: no corners"
msgstr "自動：不畫圓角"

#: src/lib/rulePresenter.js:72
msgid "Automatic: corners drawn"
msgstr "自動：畫圓角"

#: src/lib/rulePresenter.js:75
msgid "Automatic: no shadow"
msgstr "自動：不畫陰影"

#: src/lib/rulePresenter.js:75
msgid "Automatic: shadow drawn"
msgstr "自動：畫陰影"

#: src/lib/rulePresenter.js:77
msgid "Automatic: edges fixed"
msgstr "自動：邊緣不可拖動"

#: src/lib/rulePresenter.js:77
msgid "Automatic: edges draggable"
msgstr "自動：邊緣可拖動"

#: src/lib/rulePresenter.js:93
msgid "Windows of this kind are never decorated"
msgstr "這類視窗不裝飾"

#. Translators: Shown where a resize control would be, but cannot be used.
#: src/lib/rulePresenter.js:102
msgid "The window frame can already be resized"
msgstr "邊框由系統繪製，本身可拖動"

#. Translators: Shown where a resize control would be, but cannot be used.
#: src/lib/rulePresenter.js:105
msgid "Fixed-size windows have no resize handle"
msgstr "尺寸固定的視窗沒有可拖動的邊緣"

#: src/lib/rulePresenter.js:118 src/prefs/conflictDialog.js:193
msgid "Automatic"
msgstr "自動"

#. Translators: A dialog window.
#: src/lib/rulePresenter.js:124
msgid "dialog"
msgstr "對話框"

#. Translators: A dialog that blocks its parent window.
#: src/lib/rulePresenter.js:126
msgid "modal dialog"
msgstr "強制回應對話框"

#. Translators: A small utility window, such as a palette or a toolbar.
#: src/lib/rulePresenter.js:128
msgid "utility window"
msgstr "工具視窗"

#. Translators: A normal, top-level window.
#: src/lib/rulePresenter.js:133
msgid "window"
msgstr "視窗"

#: src/lib/rulePresenter.js:140
msgid "XWayland"
msgstr "XWayland"

#: src/lib/rulePresenter.js:140
msgid "Wayland"
msgstr "Wayland"

#. Translators: %s is client type then window type ("Wayland window"); reorder with %2$s %1$s.
#: src/lib/rulePresenter.js:142
#, javascript-format
msgid "%s %s"
msgstr "%s %s"

#. Translators: The window has no parent window.
#: src/lib/rulePresenter.js:145
msgid "with no parent"
msgstr "沒有上層視窗"

#. Translators: The window is attached to its parent window.
#: src/lib/rulePresenter.js:147
msgid "attached to its parent"
msgstr "跟隨上層視窗"

#. Translators: The window has a parent window it is not attached to.
#: src/lib/rulePresenter.js:149
msgid "with a parent"
msgstr "有上層視窗"

#. Translators: %s is the width and height of the window, e.g. "fixed-size (360×420)".
#: src/lib/rulePresenter.js:164
#, javascript-format
msgid "fixed-size (%s)"
msgstr "固定尺寸（%s）"

#. Translators: A window the user cannot resize.
#: src/lib/rulePresenter.js:167
msgid "fixed-size"
msgstr "固定尺寸"

#. Translators: A window the user can resize.
#: src/lib/rulePresenter.js:171
msgid "resizable"
msgstr "可縮放"

#. Translators: The compositor draws this window's frame, so it owns the resize handles.
#: src/lib/rulePresenter.js:178
msgid "frame drawn by the system"
msgstr "邊框由系統繪製"

#. Translators: The window declares no shadow margin ring of its own.
#: src/lib/rulePresenter.js:181
msgid "no shadow margins"
msgstr "未宣告陰影邊距"

#. Translators: %s is the entity, parent, frame clause, and size, in that order.
#: src/lib/rulePresenter.js:186
#, javascript-format
msgid "%s, %s, %s, %s"
msgstr "%s，%s，%s，%s"

#. Translators: %s is the entity, parent, and size, in that order.
#: src/lib/rulePresenter.js:190
#, javascript-format
msgid "%s, %s, %s"
msgstr "%s，%s，%s"

#: src/prefs.js:41
msgid "General"
msgstr "一般"

#: src/prefs.js:47
msgid "Display & Rendering"
msgstr "顯示與轉譯"

#: src/prefs.js:48
msgid "Control how windows are decorated at different monitor scales"
msgstr "依螢幕縮放決定裝飾方式"

#: src/prefs.js:53
msgid "Prioritize crisp text"
msgstr "優先保持文字清晰"

#: src/prefs.js:54
msgid ""
"Skip rounded corners on monitors with fractional scaling to keep text sharp "
"(the shadow is unaffected)"
msgstr "分數縮放下不畫圓角，以保持文字清晰（陰影不受影響）"

#: src/prefs.js:60
msgid "Force overview corners on every window"
msgstr "強制所有視窗顯示概覽圓角"

#: src/prefs.js:61
msgid ""
"Round XWayland and the few Wayland windows left square for sharpness (they "
"come out blurrier)"
msgstr ""
"XWayland 視窗，以及少數為保持清晰留成直角的 Wayland 視窗，也畫上圓角（代價是"
"更模糊）為清晰而保持直角的 XWayland 及極少數 Wayland 視窗也畫上圓角（代價是更"
"模糊）"

#: src/prefs/clipboardActions.js:23
msgid "No corrections to export"
msgstr "沒有可匯出的修正"

#: src/prefs/clipboardActions.js:35
#, javascript-format
msgid "Exported %d correction to clipboard"
msgid_plural "Exported %d corrections to clipboard"
msgstr[0] "已將 %d 條修正規則匯出至剪貼簿"

#: src/prefs/clipboardActions.js:61
msgid "Clipboard is empty or does not contain text"
msgstr "剪貼簿是空的，或不包含文字"

#: src/prefs/clipboardActions.js:94
#, javascript-format
msgid "Import failed: %s"
msgstr "匯入失敗：%s"

#: src/prefs/clipboardActions.js:105
msgid "All rules in clipboard are already up to date"
msgstr "剪貼簿中的規則已是最新"

#: src/prefs/clipboardActions.js:110
#, javascript-format
msgid "Imported %d rule successfully"
msgid_plural "Imported %d rules successfully"
msgstr[0] "成功匯入 %d 條規則"

#: src/prefs/conflictDialog.js:14
msgid "Resolve Import Conflicts"
msgstr "處理匯入衝突"

#: src/prefs/conflictDialog.js:45
msgid "Cancel"
msgstr "取消"

#: src/prefs/conflictDialog.js:51
msgid "Apply"
msgstr "套用"

#: src/prefs/conflictDialog.js:62
#, javascript-format
msgid "%d conflicting rule:"
msgid_plural "%d conflicting rules:"
msgstr[0] "%d 條規則存在衝突："

#: src/prefs/conflictDialog.js:78
msgid "Keep"
msgstr "保留"

#: src/prefs/conflictDialog.js:79
msgid "Keep existing rules for all conflicts"
msgstr "每一處衝突都保留現有規則"

#: src/prefs/conflictDialog.js:84
msgid "Replace"
msgstr "取代"

#: src/prefs/conflictDialog.js:85
msgid "Replace existing rules with imported rules for all conflicts"
msgstr "每一處衝突都換成匯入的規則"

#: src/prefs/conflictDialog.js:159
msgid "Could not apply the changes. Review your selections and try again."
msgstr "套用失敗，請重新檢查每一處衝突的處理方式"

#: src/prefs/rulePage.js:89
msgid "Revert to the automatic decision"
msgstr "回復自動判斷"

#
#: src/prefs/rulePage.js:173
msgid "Pick window…"
msgstr "選取視窗…"

#: src/prefs/rulePage.js:176
msgid "The correction applies to every window of its kind"
msgstr "對所有同類視窗生效"

#: src/prefs/rulePage.js:181
msgid "Import from Clipboard"
msgstr "從剪貼簿匯入"

#: src/prefs/rulePage.js:182
msgid "Export to Clipboard"
msgstr "匯出到剪貼簿"

#: src/prefs/rulePage.js:188 src/prefs/rulePage.js:191
msgid "More actions"
msgstr "更多操作"

#: src/prefs/rulePage.js:203
msgid "Corrections"
msgstr "誤判修正"

#
#: src/prefs/rulePage.js:204
msgid ""
"Corrections apply per window kind; a switch corrects the automatic decision "
"for one axis"
msgstr "修正依視窗種類分別生效；開啟開關，該軸改為與自動判斷相反"

#: src/prefs/rulePage.js:240
msgid "Use “Pick window…” to correct a window that is decorated incorrectly"
msgstr "裝飾不正確的視窗，點「選取視窗…」新增修正"

#. Translators: Tooltip on a correction switch: turning it on reverses the automatic decision.
#: src/prefs/ruleUi.js:96
msgid "Turn on to correct the automatic decision for this window kind"
msgstr "開啟後，這一軸與自動判斷相反"

#: src/prefs/ruleUi.js:126
#, javascript-format
msgid "Picked from the window “%s”"
msgstr "選自視窗「%s」"

#. Translators: Closes the error dialog.
#: src/prefs/ruleUi.js:137
msgid "Close"
msgstr "關閉"

#: src/prefs/windowPicker.js:18
msgid "No correction added: this window could not be identified"
msgstr "無法辨識這個視窗，未新增修正"

#: src/prefs/windowPicker.js:22
msgid ""
"No correction added: the extension did not answer — restart the session and "
"pick again"
msgstr "擴充功能沒有回應，未新增修正；請重新登入後再選取"

#. The one way a correction cannot act: the window is below the size both cuts need to fit.
#: src/prefs/windowPicker.js:24
msgid "No correction added: this window is too small to decorate"
msgstr "視窗過小，無法裝飾，未新增修正"

#: src/prefs/windowPicker.js:71
msgid "Window Pick Failed"
msgstr "選取視窗失敗"

#
#: src/prefs/windowPicker.js:73
msgid "A window is already being picked"
msgstr "正在選取視窗"

#: src/prefs/windowPicker.js:74
msgid "Could not connect to the Window Nativizer extension: it is not enabled"
msgstr "Window Nativizer 擴充功能沒有啟用，無法選取視窗"

#: src/prefs/windowPicker.js:101
msgid "No correction added: it could not be saved"
msgstr "儲存失敗，未新增修正"

#: src/prefs/windowPicker.js:113
#, javascript-format
msgid "Correction updated for %s: %s"
msgstr "已更新 %s 的修正：%s"

#: src/prefs/windowPicker.js:114
#, javascript-format
msgid "Correction added for %s: %s"
msgstr "已為 %s 新增修正：%s"

#: src/prefs/windowPicker.js:124
msgid "The correction takes effect once the window is restored"
msgstr "視窗結束最大化或並排後，才能看到修正效果"
