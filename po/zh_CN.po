#. Translators: One of the three rule axes: rounded window corners.
#: src/prefs.js:32
msgid "Corners"
msgstr "圆角"

#. Translators: One of the three rule axes: the window shadow.
#: src/prefs.js:34
msgid "Shadow"
msgstr "阴影"

#. Translators: One of the three rule axes: the resize band around the window.
#: src/prefs.js:36
msgid "Resize"
msgstr "调整大小"

#. Translators: A rule axis follows the extension's own decision.
#: src/prefs.js:52
msgid "Automatic"
msgstr "自动"

#. Translators: A rule axis does the opposite of the extension's own decision.
#: src/prefs.js:54
msgid "Reverse"
msgstr "反向"

#: src/prefs.js:105
msgid "Windows of this type are never decorated"
msgstr "此类窗口不做装饰"

#. Translators: Shown where a resize control would be, but cannot be used.
#: src/prefs.js:121
msgid "The window frame already handles resizing"
msgstr "窗口边框已负责缩放"

#. Translators: Shown where a resize control would be, but cannot be used.
#: src/prefs.js:124
msgid "No resize handle on fixed-size windows"
msgstr "不可调整大小的窗口没有抓手可配"

#. Translators: A dialog window.
#: src/prefs.js:147
msgid "dialog"
msgstr "对话框"

#. Translators: A dialog that blocks its parent window.
#: src/prefs.js:149
msgid "modal dialog"
msgstr "模态对话框"

#. Translators: A small utility window, such as a palette or a toolbar.
#: src/prefs.js:151
msgid "utility window"
msgstr "工具窗口"

#. Translators: A normal, top-level window.
#: src/prefs.js:156
msgid "window"
msgstr "窗口"

#: src/prefs.js:167
msgid "X11"
msgstr "X11"

#: src/prefs.js:167
msgid "Wayland"
msgstr "Wayland"

#. Translators: %s is the client type and the window type, e.g. "Wayland window".
#: src/prefs.js:169
#, javascript-format
msgid "%s %s"
msgstr "%s %s"

#. Translators: The window has no parent window.
#: src/prefs.js:172
msgid "with no parent"
msgstr "无父窗口"

#. Translators: The window is attached to its parent window.
#: src/prefs.js:174
msgid "attached to its parent"
msgstr "附加到父窗口"

#. Translators: The window has a parent window it is not attached to.
#: src/prefs.js:176
msgid "with a parent"
msgstr "有父窗口"

#. Translators: %s is the width and height of the window, e.g. "fixed-size (360×420)".
#: src/prefs.js:191
#, javascript-format
msgid "fixed-size (%s)"
msgstr "固定大小（%s）"

#. Translators: A window the user cannot resize.
#: src/prefs.js:194
msgid "fixed-size"
msgstr "固定大小"

#. Translators: A window the user can resize.
#: src/prefs.js:198
msgid "resizable"
msgstr "大小可调"

#. Translators: The compositor draws this window's frame, so it owns the resize handles.
#: src/prefs.js:206
msgid "framed by the system"
msgstr "由系统绘制边框"

#. Translators: The window declares no shadow margin ring of its own.
#: src/prefs.js:209
msgid "without shadow margins"
msgstr "无阴影边距"

#. Translators: %s is the entity, parent, frame clause, and size, in that order.
#: src/prefs.js:214
#, javascript-format
msgid "%s, %s, %s, %s"
msgstr "%s，%s，%s，%s"

#. Translators: %s is the entity, parent, and size, in that order.
#: src/prefs.js:218
#, javascript-format
msgid "%s, %s, %s"
msgstr "%s，%s，%s"

#. Translators: Closes the error dialog.
#: src/prefs.js:306
msgid "Close"
msgstr "关闭"

#: src/prefs.js:339
msgid "General"
msgstr "常规"

#: src/prefs.js:345
msgid "Display & Rendering"
msgstr "显示与渲染"

#: src/prefs.js:346
msgid "Control window decoration behavior across screen scales"
msgstr "控制窗口装饰在不同屏幕缩放下的渲染行为"

#: src/prefs.js:351
msgid "Prioritize Crisp Text"
msgstr "优先保证文字清晰"

#: src/prefs.js:352
msgid ""
"Skip rounded corners on fractional scale monitors (retaining shadow) to "
"avoid text blur and resampling overhead"
msgstr ""
"在分数缩放屏幕上跳过圆角（保留阴影），避免重采样带来的文字模糊与性能开销"

#: src/prefs.js:360 src/prefs.js:364
msgid "Pick a window to add a rule"
msgstr "选取窗口以添加规则"

#: src/prefs.js:367 src/prefs.js:385 src/prefs.js:386
msgid "Window Rules"
msgstr "窗口规则"

#: src/prefs.js:368
msgid "Per-window-kind rules that reverse the automatic decoration"
msgstr "按窗口种类反向自动装饰的规则"

#: src/prefs.js:390
msgid "Use the button above to pick a window and add a rule"
msgstr "用上面的按钮选取窗口以添加规则"

#. Translators: %s is the axis name, e.g. "Corners".
#: src/prefs.js:443
#, javascript-format
msgid "%s setting"
msgstr "%s设置"

#: src/prefs.js:515 src/prefs.js:517
msgid "Remove Rule"
msgstr "删除规则"

#: src/prefs.js:550
msgid ""
"Each axis follows the automatic decision; reverse the ones you disagree with"
msgstr "每个轴跟随自动判断；不认同的，把它反向"

#: src/prefs.js:603
msgid "Window Inspection Failed"
msgstr "窗口选取失败"

#: src/prefs.js:604
msgid "Could not connect to the Window Nativizer extension — it is not enabled"
msgstr "无法连接到 Window Nativizer 扩展——该扩展未启用"

#: src/prefs.js:616
msgid "No rule added: this window could not be identified"
msgstr "未添加规则：无法识别这个窗口"

#: src/prefs.js:647
msgid "No rule added: it would have no effect on a window of this kind"
msgstr "未添加规则：这条规则对此类窗口不会有任何效果"

#: src/prefs.js:661
msgid "No rule added: the rule could not be saved"
msgstr "未添加规则：规则未能保存"

#: src/prefs.js:673
#, javascript-format
msgid "Rule updated for %s: %s"
msgstr "已更新 %s 的规则：%s"

#: src/prefs.js:674
#, javascript-format
msgid "Rule added for %s: %s"
msgstr "已为 %s 添加规则：%s"

#: src/prefs.js:684
msgid "The rule takes effect once the window is restored"
msgstr "窗口还原后规则生效"
