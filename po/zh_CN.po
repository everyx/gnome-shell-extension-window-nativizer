#. Translators: One of the three rule axes: rounded window corners.
#: src/prefs.js:34
msgid "Corners"
msgstr "圆角"

#. Translators: One of the three rule axes: the window shadow.
#: src/prefs.js:36
msgid "Shadow"
msgstr "阴影"

#. Translators: One of the three rule axes: the resize band around the window.
#: src/prefs.js:38
msgid "Resize"
msgstr "调整大小"

#. Translators: %s is the axis name, e.g. "Corners".
#: src/prefs.js:56
#, javascript-format
msgid "%s: corrected"
msgstr "%s：已修正"

#: src/prefs.js:85
msgid "Windows of this kind are never decorated"
msgstr "此类窗口不做装饰"

#. Translators: Shown where a resize control would be, but cannot be used.
#: src/prefs.js:101
msgid "The window frame can already be resized"
msgstr "窗口边框本身已可调整大小"

#. Translators: Shown where a resize control would be, but cannot be used.
#: src/prefs.js:104
msgid "Fixed-size windows have no resize handle"
msgstr "固定大小的窗口没有可调整大小的边缘"

#. Translators: A dialog window.
#: src/prefs.js:127
msgid "dialog"
msgstr "对话框"

#. Translators: A dialog that blocks its parent window.
#: src/prefs.js:129
msgid "modal dialog"
msgstr "模态对话框"

#. Translators: A small utility window, such as a palette or a toolbar.
#: src/prefs.js:131
msgid "utility window"
msgstr "工具窗口"

#. Translators: A normal, top-level window.
#: src/prefs.js:136
msgid "window"
msgstr "窗口"

#: src/prefs.js:147
msgid "X11"
msgstr "X11"

#: src/prefs.js:147
msgid "Wayland"
msgstr "Wayland"

#. Translators: %s is the client type and the window type, e.g. "Wayland window". If your
#: src/prefs.js:149
#, javascript-format
msgid "%s %s"
msgstr "%s %s"

#. Translators: The window has no parent window.
#: src/prefs.js:152
msgid "with no parent"
msgstr "无父窗口"

#. Translators: The window is attached to its parent window.
#: src/prefs.js:154
msgid "attached to its parent"
msgstr "附加到父窗口"

#. Translators: The window has a parent window it is not attached to.
#: src/prefs.js:156
msgid "with a parent"
msgstr "有父窗口"

#. Translators: %s is the width and height of the window, e.g. "fixed-size (360×420)".
#: src/prefs.js:171
#, javascript-format
msgid "fixed-size (%s)"
msgstr "固定大小（%s）"

#. Translators: A window the user cannot resize.
#: src/prefs.js:174
msgid "fixed-size"
msgstr "固定大小"

#. Translators: A window the user can resize.
#: src/prefs.js:178
msgid "resizable"
msgstr "可调整大小"

#. Translators: The compositor draws this window's frame, so it owns the resize handles.
#: src/prefs.js:186
msgid "frame drawn by the system"
msgstr "由系统绘制边框"

#. Translators: The window declares no shadow margin ring of its own.
#: src/prefs.js:189
msgid "no shadow margins"
msgstr "无阴影边距"

#. Translators: %s is the entity, parent, frame clause, and size, in that order.
#: src/prefs.js:194
#, javascript-format
msgid "%s, %s, %s, %s"
msgstr "%s，%s，%s，%s"

#. Translators: %s is the entity, parent, and size, in that order.
#: src/prefs.js:198
#, javascript-format
msgid "%s, %s, %s"
msgstr "%s，%s，%s"

#. Translators: Closes the error dialog.
#: src/prefs.js:293
msgid "Close"
msgstr "关闭"

#. Translators: Tooltip on a correction switch: turning it on reverses the automatic decision.
#: src/prefs.js:360
msgid "Turn on to correct the automatic decision for this window kind"
msgstr "开启后修正此类窗口的自动判断"

#: src/prefs.js:396
#, javascript-format
msgid "Picked from the window “%s”"
msgstr "选取自窗口“%s”"

#: src/prefs.js:412 src/prefs.js:414
msgid "Revert to the automatic decision"
msgstr "还原为自动判断"

#: src/prefs.js:498
msgid "Window Pick Failed"
msgstr "窗口选取失败"

#: src/prefs.js:500
msgid "A window is already being picked"
msgstr "窗口选取正在进行"

#: src/prefs.js:501
msgid "Could not connect to the Window Nativizer extension — it is not enabled"
msgstr "无法连接到 Window Nativizer 扩展——该扩展未启用"

#: src/prefs.js:513
msgid "No correction added: this window could not be identified"
msgstr "未添加修正：无法识别这个窗口"

#: src/prefs.js:534
msgid ""
"No correction added: the extension did not answer — restart the session and "
"pick again"
msgstr "未添加修正：扩展没有响应——请重启会话后重新选取"

#: src/prefs.js:542
msgid "No correction added: it would have no effect on a window of this kind"
msgstr "未添加修正：这条修正对此类窗口不会有任何效果"

#: src/prefs.js:560
msgid "No correction added: it could not be saved"
msgstr "未添加修正：修正未能保存"

#: src/prefs.js:572
#, javascript-format
msgid "Correction updated for %s: %s"
msgstr "已更新 %s 的修正：%s"

#: src/prefs.js:573
#, javascript-format
msgid "Correction added for %s: %s"
msgstr "已为 %s 添加修正：%s"

#: src/prefs.js:583
msgid "The correction takes effect once the window is restored"
msgstr "窗口还原后修正生效"

#: src/prefs.js:601
msgid "Pick window…"
msgstr "选取窗口…"

#: src/prefs.js:604
msgid "The correction applies to every window of its kind"
msgstr "这条修正对此类所有窗口生效"

#: src/prefs.js:612
msgid "Corrections"
msgstr "误判修正"

#: src/prefs.js:613
msgid ""
"Corrections apply per window kind; a switch corrects the automatic decision "
"for one axis"
msgstr "修正按窗口种类生效；开关修正其中一个轴的自动判断"

#: src/prefs.js:658
msgid "Use the button above to pick a window that is decorated incorrectly"
msgstr "点击上方按钮，选取装饰不正确的窗口"

#: src/prefs.js:722
msgid "General"
msgstr "常规"

#: src/prefs.js:728
msgid "Display & Rendering"
msgstr "显示与渲染"

#: src/prefs.js:729
msgid "Control how windows are decorated at different monitor scales"
msgstr "控制窗口在不同显示器缩放下的装饰方式"

#: src/prefs.js:734
msgid "Prioritize crisp text"
msgstr "优先保证文字清晰"

#: src/prefs.js:735
msgid ""
"Skip rounded corners on monitors with fractional scaling to keep text sharp "
"(the shadow is unaffected)"
msgstr "在分数缩放的显示器上跳过圆角，以保持文字清晰（阴影不受影响）"
