{
  "name": "window-nativizer",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "GNOME Shell extension: brings native GNOME rounded corners, GPU shadows, and resize bands to non-native windows",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/everyx/gnome-shell-extension-window-nativizer.git"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:shell": "tools/dev.sh shell",
    "dev:log": "tools/dev.sh log",
    "dev:app": "tools/dev.sh app",
    "dev:stop": "tools/dev.sh stop",
    "dev:kit": "tools/devkit.sh",
    "pretest": "pnpm run gen:locale",
    "test": "jasmine --module tests/",
    "test:e2e": "tools/test-e2e.sh",
    "test:bench": "python3 tools/benchmark-decoration.py",
    "test:perf": "python3 tools/benchmark-perf.py",
    "lint": "eslint src/ tests/ tools/",
    "lint:ego": "bash \"${EGO_LINT:-$HOME/.local/share/gnome-extension-reviewer/ego-lint}\" src/",
    "lint:zip": "uvx --with 'tree-sitter<0.26.0' shexli dist/window-nativizer@everyx.github.io.shell-extension.zip || (pipx install --force shexli && pipx runpip shexli install 'tree-sitter<0.26.0' && shexli dist/window-nativizer@everyx.github.io.shell-extension.zip)",
    "check": "pnpm run lint && pnpm run check:style && pnpm test && pnpm run check:bench",
    "check:style": "tools/check-style.sh",
    "check:bench": "python3 tools/benchmark-decoration.py --check",
    "check:perf": "python3 tools/benchmark-perf.py --check",
    "gen:code": "tools/gen-code.sh",
    "gen:locale": "node tools/gen-locale.mjs",
    "gen:extract": "node tools/gen-locale.mjs --extract",
    "gen:preview": "python3 tools/generate-preview.py",
    "build": "tools/pack.sh",
    "pack": "tools/pack.sh",
    "install:ext": "pnpm run build && gnome-extensions install --force dist/window-nativizer@everyx.github.io.shell-extension.zip",
    "install-ext": "pnpm run install:ext",
    "check-style": "pnpm run check:style",
    "gen-style": "pnpm run gen:code",
    "compile-locales": "pnpm run gen:locale",
    "update-po": "pnpm run gen:extract",
    "ego-lint": "pnpm run lint:ego",
    "shexli": "pnpm run lint:zip",
    "benchmark": "pnpm run test:bench",
    "benchmark:check": "pnpm run check:bench",
    "benchmark:perf": "pnpm run test:perf",
    "benchmark:perf:check": "pnpm run check:perf",
    "preview": "pnpm run gen:preview"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-gnome": "git+https://gitlab.gnome.org/World/javascript/eslint-config-gnome.git"
  }
}
