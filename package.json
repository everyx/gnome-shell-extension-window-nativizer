{
  "name": "window-nativizer",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "description": "GNOME Shell extension: brings native GNOME rounded corners, GPU shadows, and resize bands to non-native windows",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/everyx/gnome-shell-extension-window-nativizer.git"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "pretest": "pnpm run gen:locale",
    "test": "jasmine --module tests/",
    "test:tools": "node --test tools/*.test.mjs",
    "stats": "node tools/stats.mjs",
    "check:volume": "node tools/stats.mjs --check",
    "test:e2e": "tools/test-e2e.sh",
    "test:decoration": "python3 tools/check-decoration.py",
    "test:flat-border": "python3 tools/flat-border-runs.py",
    "test:perf": "python3 tools/benchmark-perf.py",
    "lint": "eslint src/ tests/ tools/",
    "lint:ego": "bash \"${EGO_LINT:-$HOME/.local/share/gnome-extension-reviewer/ego-lint}\" src/",
    "lint:zip": "tools/lint-zip.sh",
    "check": "pnpm run lint && pnpm run check:style && pnpm run test:tools && pnpm test && pnpm run check:decoration",
    "check:style": "tools/check-style.sh",
    "check:decoration": "python3 tools/check-decoration.py --check",
    "check:perf": "python3 tools/benchmark-perf.py --check",
    "gen:code": "tools/gen-code.sh",
    "gen:locale": "node tools/gen-locale.mjs",
    "gen:extract": "node tools/gen-locale.mjs --extract",
    "gen:preview": "python3 tools/generate-preview.py",
    "build": "tools/pack.sh",
    "install:ext": "pnpm run build && gnome-extensions install --force dist/window-nativizer@everyx.github.io.shell-extension.zip"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-gnome": "git+https://gitlab.gnome.org/World/javascript/eslint-config-gnome.git",
    "eslint-plugin-slop": "^0.1.3"
  }
}
